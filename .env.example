# Server only. Fill the key, choose a model supported by your gateway.
AI_BASE_URL=https://tokengateway.ai.id/v1
AI_API_KEY=
# Primary first; fallback is tried once for unavailable/rate-limited/failed/invalid responses.
AI_MODEL=gpt-6-sol
# Leave explicitly empty to disable fallback.
# Comma-separated backups, tried in order.
AI_FALLBACK_MODEL=gemini-3.8-flash,gpt-6.1-sol,gpt-6-astra
# VirusTotal API v3. Hash lookup is automatic once this key is filled.
# Uploading an unknown file requires selecting the sharing option in the dashboard.
VIRUSTOTAL_API_KEY=
# shared password login; set the requested password here, never in client code.
ACCESS_PASSWORD=
# Alternative for production: scrypt salt:hash generated by scripts/password-hash.mjs.
ACCESS_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Scheduled cleanup authorization (Vercel sends this value as a Bearer token).
CRON_SECRET=
# Server only. No NEXT_PUBLIC secrets needed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=kheronyx-quarantine

# abuse.ch Auth-Key (free at https://auth.abuse.ch): URLhaus/ThreatFox/MalwareBazaar lookups and the corpus
# evaluation script. Server only.
ABUSE_CH_AUTH_KEY=
